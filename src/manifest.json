{
  "manifest_version": 3,
  "name": "Calm Captions",
  "version": "2.6.0",
  "description": "Calmer subtitles for YouTube (including videos embedded on other sites) and Udemy: rounded, easy on the eyes. Pick your font, size and colors.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "Outfit.ttf"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/*",
        "https://*.udemy.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/*",
        "https://*.udemy.com/*"
      ],
      "css": [
        "captions.css"
      ],
      "js": [
        "cues.js",
        "captions.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}